# انسخ هذا الملف إلى .env وعبّئ القيم، أو صدّرها مباشرة في الطرفية.

# مفتاح Claude API (مطلوب) — احصل عليه من https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# اسم شركتك (اختياري)
COMPANY_NAME=شركتنا

# النموذج (اختياري): claude-haiku-4-5 (الأرخص) | claude-sonnet-5 | claude-opus-4-8
CLAUDE_MODEL=claude-haiku-4-5
